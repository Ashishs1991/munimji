# Copy this file to .env and fill in values locally.
# .env is gitignored. Do not put real keys in application.yml.
# Format is KEY=value with no "export" prefix. Blank means unset.
# Add every new API key here and in src/main/resources/application.yml together.

# --- Application ---
SERVER_PORT=8080
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# --- PostgreSQL (Supabase) ---
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Supabase Auth, API, and private storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=

# --- Meta model API ---
META_API_KEY=
META_API_BASE_URL=
META_REASONING_MODEL=muse-spark-1.3
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=

# --- Reminders ---
REMINDER_GRACE_MINUTES=15

# --- Optional Tally connector. Leave disabled until that add-on is built. ---
TALLY_ENABLED=false
TALLY_CONNECTOR_TOKEN=

# --- Optional e-way bill connector. Leave disabled until that add-on is built. ---
EWAY_ENABLED=false
EWAY_ENVIRONMENT=sandbox
EWAY_BASE_URL=
EWAY_CLIENT_ID=
EWAY_CLIENT_SECRET=
